{"step_index":181,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-20T20:43:30Z","content":"Created At: 2026-11-20T22:43:30+02:00\nCompleted At: 2026-11-20T22:43:30+02:00\nCreated At: 2026-11-20T22:43:30+02:00\nCompleted At: 2026-11-20T22:43:30+02:00\nShowing lines 1-202 of 202\n1: import pathlib\n2: import pandas as pd\n3: \n4: # Columns for the exception register (order matters for CSV export)\n5: EXCEPTION_COLUMNS = [\n6:     \"ExceptionKey\",\n7:     \"SourceTable\",\n8:     \"RecordIdentifier\",\n9:     \"RuleViolated\",\n10:     \"Severity\",\n11:     \"Disposition\",\n12:     \"Description\",\n13: ]\n14: \n15: def _load_dimensions(raw_dir: pathlib.Path):\n16:     dim_tables = {}\n17:     for dim in [\"DimDate\", \"DimShift\", \"DimLine\", \"DimMachine\", \"DimProduct\", \"DimReason\"]:\n18:         dim_tables[dim] = pd.read_csv(raw_dir / f\"{dim}.csv\")\n19:     return dim_tables\n20: \n21: def _validate_table(df: pd.DataFrame, table_name: str, pk_col: str, fk_map: dict, dim_tables: dict):\n22:     \"\"\"Validate a fact table and return good rows + a list of exception dicts.\n23:     \n24:     Parameters\n25:     ----------\n26:     df: DataFrame – fact table (may contain faulty rows).\n27:     table_name: str – name of the source table.\n28:     pk_col: str – primary‑key column name.\n29:     fk_map: dict – foreign‑key column -> (dim_name, dim_key_col).\n30:     dim_tables: dict – pre‑loaded dimension DataFrames.\n31:     \"\"\"\n32:     exceptions = []\n33:     good_mask = pd.Series(True, index=df.index)\n34: \n35:     # 1. Duplicate primary keys\n36:     dup_mask = df[pk_col].duplicated(keep=False)\n37:     for idx in df[dup_mask].index:\n38:         exceptions.append({\n39:             \"SourceTable\": table_name,\n40:             \"RecordIdentifier\": str(df.at[idx, pk_col]),\n41:             \"RuleViolated\": \"DuplicatePrimaryKey\",\n42:             \"Severity\": \"High\",\n43:             \"Disposition\": \"Quarantine\",\n44:             \"Description\": f\"Primary key {df.at[idx, pk_col]} appears multiple times.\",\n45:         })\n46:     good_mask &= ~dup_mask\n47: \n48:     # 2. Orphaned foreign keys\n49:     for fk_col, (dim_name, dim_key) in fk_map.items():\n50:         valid_keys = set(dim_tables[dim_name][dim_key])\n51:         orphan_mask = ~df[fk_col].isin(valid_keys)\n52:         for idx in df[orphan_mask].index:\n53:             exceptions.append({\n54:                 \"SourceTable\": table_name,\n55:                 \"RecordIdentifier\": str(df.at[idx, pk_col]),\n56:                 \"RuleViolated\": \"OrphanForeignKey\",\n57:                 \"Severity\": \"High\",\n58:                 \"Disposition\": \"Quarantine\",\n59:                 \"Description\": f\"{fk_col} value {df.at[idx, fk_col]} not found in {dim_name}.\",\n60:             })\n61:         good_mask &= ~orphan_mask\n62: \n63:     # 3. Non‑negative numeric columns (units, minutes, kWh)\n64:     numeric_cols = [c for c in df.columns if c.lower().endswith('units') or c.lower().endswith('minutes') or c.lower().endswith('kwh')]\n65:     for col in numeric_cols:\n66:         neg_mask = df[col] < 0\n67:         for idx in df[neg_mask].index:\n68:             exceptions.append({\n69:                 \"SourceTable\": table_name,\n70:                 \"RecordIdentifier\": str(df.at[idx, pk_col]),\n71:                 \"RuleViolated\": \"NegativeValue\",\n72:                 \"Severity\": \"Medium\",\n73:                 \"Disposition\": \"Quarantine\",\n74:                 \"Description\": f\"Column {col} has negative value {df.at[idx, col]}.\",\n75:             })\n76:         good_mask &= ~neg_mask\n77: \n78:     # 4. Production unit consistency (specific to FactProduction)\n79:     if table_name == \"FactProduction\":\n80:         inc_mask = df['GoodUnits'] + df['RejectedUnits'] != df['ProducedUnits']\n81:         for idx in df[inc_mask].index:\n82:             exceptions.append({\n83:                 \"SourceTable\": table_name,\n84:                 \"RecordIdentifier\": str(df.at[idx, pk_col]),\n85:                 \"RuleViolated\": \"UnitSumMismatch\",\n86:                 \"Severity\": \"Medium\",\n87:                 \"Disposition\": \"Quarantine\",\n88:                 \"Description\": \"GoodUnits + RejectedUnits does not equal ProducedUnits.\",\n89:             })\n90:         good_mask &= ~inc_mask\n91: \n92:     good_df = df[good_mask].copy()\n93:     return good_df, exceptions\n94: \n95: def run_validation():\n96:     \"\"\"Run validation on the faulty raw data.\n97:     Writes curated fact CSVs to ``data/curated/`` and an exception register.\n98:     Also creates a concise markdown report under ``docs/validation_report.md``.\n99:     \"\"\"\n100:     base = pathlib.Path(__file__).resolve().parents[1]  # repository root\n101:     raw_dir = base / \"data\" / \"raw\" / \"faulty\"\n102:     curated_dir = base / \"data\" / \"curated\"\n103:     curated_dir.mkdir(parents=True, exist_ok=True)\n104: \n105:     # Load dimensions (assumed clean)\n106:     dim_tables = _load_dimensions(raw_dir)\n107: \n108:     # Fact table metadata: primary key and foreign‑key mappings\n109:     fact_meta = {\n110:         \"FactProduction\": {\n111:             \"pk\": \"ProductionKey\",\n112:             \"fks\": {\n113:                 \"DateKey\": (\"DimDate\", \"DateKey\"),\n114:                 \"ShiftKey\": (\"DimShift\", \"ShiftKey\"),\n115:                 \"MachineKey\": (\"DimMachine\", \"MachineKey\"),\n116:                 \"ProductKey\": (\"DimProduct\", \"ProductKey\"),\n117:             },\n118:         },\n119:         \"FactDowntime\": {\n120:             \"pk\": \"DowntimeKey\",\n121:             \"fks\": {\n122:                 \"DateKey\": (\"DimDate\", \"DateKey\"),\n123:                 \"ShiftKey\": (\"DimShift\", \"ShiftKey\"),\n124:                 \"MachineKey\": (\"DimMachine\", \"MachineKey\"),\n125:                 \"ReasonKey\": (\"DimReason\", \"ReasonKey\"),\n126:             },\n127:         },\n128:         \"FactQuality\": {\n129:             \"pk\": \"QualityKey\",\n130:             \"fks\": {\n131:                 \"DateKey\": (\"DimDate\", \"DateKey\"),\n132:                 \"ShiftKey\": (\"DimShift\", \"ShiftKey\"),\n133:                 \"MachineKey\": (\"DimMachine\", \"MachineKey\"),\n134:                 \"ProductKey\": (\"DimProduct\", \"ProductKey\"),\n135:                 \"DefectReasonKey\": (\"DimReason\", \"ReasonKey\"),\n136:             },\n137:         },\n138:         \"FactEnergy\": {\n139:             \"pk\": \"EnergyKey\",\n140:             \"fks\": {\n141:                 \"DateKey\": (\"DimDate\", \"DateKey\"),\n142:                 \"ShiftKey\": (\"DimShift\", \"ShiftKey\"),\n143:                 \"MachineKey\": (\"DimMachine\", \"MachineKey\"),\n144:             },\n145:         },\n146:         \"FactSensor\": {\n147:             \"pk\": \"SensorKey\",\n148:             \"fks\": {\n149:                 \"DateKey\": (\"DimDate\", \"DateKey\"),\n150:                 \"MachineKey\": (\"DimMachine\", \"MachineKey\"),\n151:             },\n152:         },\n153:     }\n154: \n155:     all_exceptions = []\n156:     for fact_name, meta in fact_meta.items():\n157:         df_raw = pd.read_csv(raw_dir / f\"{fact_name}.csv\")\n158:         good_df, exc = _validate_table(df_raw, fact_name, meta[\"pk\"], meta[\"fks\"], dim_tables)\n159:         # Export curated good rows\n160:         good_df.to_csv(curated_dir / f\"{fact_name}.csv\", index=False)\n161:         # Append exceptions (will be enriched later with ExceptionKey)\n162:         for e in exc:\n163:             e[\"ExceptionKey\"] = None\n164:         all_exceptions.extend(exc)\n165: \n166:         # Build exception register DataFrame\n167:     exc_df = pd.DataFrame(all_exceptions, columns=EXCEPTION_COLUMNS)\n168:     # Ensure ExceptionKey is a sequential identifier\n169:     if 'ExceptionKey' not in exc_df.columns:\n170:         exc_df.insert(0, 'ExceptionKey', range(1, len(exc_df) + 1))\n171:     else:\n172:         exc_df['ExceptionKey'] = range(1, len(exc_df) + 1)\n173:     exc_df.to_csv(curated_dir / 'FactDQExceptions.csv', index=False)\n174: exc_df = pd.DataFrame(all_exceptions, columns=EXCEPTION_COLUMNS)\n175: # Ensure ExceptionKey is a sequential identifier\n176: if 'ExceptionKey' not in exc_df.columns:\n177:     exc_df.insert(0, 'ExceptionKey', range(1, len(exc_df) + 1))\n178: else:\n179:     # Overwrite any existing values with a fresh sequential key\n180:     exc_df['ExceptionKey'] = range(1, len(exc_df) + 1)\n181: exc_df.to_csv(curated_dir / 'FactDQExceptions.csv', index=False)\n182:     exc_df = pd.DataFrame(all_exceptions, columns=EXCEPTION_COLUMNS)\n183:     exc_df.insert(0, \"ExceptionKey\", range(1, len(exc_df) + 1))\n184:     exc_df.to_csv(curated_dir / \"FactDQExceptions.csv\", index=False)\n185: \n186:     # ---- Validation report ----\n187:     report_path = base / \"docs\" / \"validation_report.md\"\n188:     total_raw = sum(pd.read_csv(raw_dir / f\"{t}.csv\").shape[0] for t in fact_meta)\n189:     total_curated = sum(pd.read_csv(curated_dir / f\"{t}.csv\").shape[0] for t in fact_meta)\n190:     total_exc = len(exc_df)\n191:     with open(report_path, \"w\", encoding=\"utf-8\") as f:\n192:         f.write(\"# Validation Report\\n\\n\")\n193:         f.write(f\"- Raw fact records: {total_raw}\\n\")\n194:         f.write(f\"- Curated (accepted) records: {total_curated}\\n\")\n195:         f.write(f\"- Detected exceptions: {total_exc}\\n\\n\")\n196:         f.write(\"## Exceptions by rule\\n\\n\")\n197:         for rule, cnt in exc_df.groupby(\"RuleViolated\").size().items():\n198:             f.write(f\"- {rule}: {cnt}\\n\")\n199:     print(f\"Validation complete – report written to {report_path}\")\n200: \n201: if __name__ == \"__main__\":\n202:     run_validation()"}
