y). Use click for CLI.\n\nImplement tests: test_simulation deterministic, test_fault_injection counts, test_validation catches faults, test_sql_integrity checks foreign keys etc., test_ai4i integration.\n\nImplement CI yaml.\n\nProceed to create files.\n\n","tool_calls":[{"name":"write_file","args":{"ArtifactMetadata":{"RequestFeedback":false,"Summary":"Data validation script generating FactDQExceptions and report","UserFacing":false},"Content":"import pathlib\nimport pandas as pd\nimport numpy as np\nfrom src.config import BASE_DIR\n\n# Exception register columns\nEXCEPTION_COLUMNS = [\n    \"ExceptionKey\",\n    \"SourceTable\",\n    \"RecordIdentifier\",\n    \"RuleViolated\",\n    \"Severity\",\n    \"Disposition\",\n    \"Description\",\n]\n\n\ndef validate_table(df: pd.DataFrame, table_name: str, pk_col: str, fk_map: dict, dim_tables: dict):\n    \"\"\"Validate a single fact table.\n\n    Parameters\n    ----------\n    df: DataFrame – the fact table (including potentially faulty rows).\n    table_name: str – name of the source table.\n    pk_col: str – primary‑key column name.\n    fk_map: dict – mapping of foreign‑key column name -> (dim_name, dim_key_col).\n    dim_tables: dict – already‑loaded dimension DataFrames keyed by name.\n\n    Returns\n    -------\n    good_df: DataFrame – rows that passed all checks.\n    exceptions: list[dict] – exception records.\n    \"\"\"\n    exceptions = []\n    good_mask = pd.Series(True, index=df.index)\n    # 1. Duplicate primary keys\n    dup_mask = df[pk_col].duplicated(keep=False)\n    for idx in df[dup_mask].index:\n        exceptions.append({\n            \"SourceTable\": table_name,\n            \"RecordIdentifier\": str(df.at[idx, pk_col]),\n            \"RuleViolated\": \"DuplicatePrimaryKey\",\n            \"Severity\": \"High\",\n            \"Disposition\": \"Quarantine\",\n            \"Description\": f\"Primary key {df.at[idx, pk_col]} appears multiple times.\",\n        })\n    good_mask &= ~dup_mask\n\n    # 2. Orphaned foreign keys\n    for fk_col, (dim_name, dim_key) in fk_map.items():\n        valid_keys = set(dim_tables[dim_name][dim_key])\n        orphan_mask = ~df[fk_col].isin(valid_keys)\n        for idx in df[orphan_mask].index:\n            exceptions.append({\n                \"SourceTable\": table_name,\n                \"RecordIdentifier\": str(df.at[idx, pk_col]),\n                \"RuleViolated\": \"OrphanForeignKey\",\n                \"Severity\": \"High\",\n                \"Disposition\": \"Quarantine\",\n                \"Description\": f\"{fk_col} value {df.at[idx, fk_col]} not found in {dim_name}.\",\n            })\n        good_mask &= ~orphan_mask\n\n    # 3. Non‑negative numeric checks (units, minutes, kWh)\n    numeric_cols = [c for c in df.columns if c.lower().endswith('units') or c.lower().endswith('minutes') or c.lower().endswith('kwh')]\n    for col in numeric_cols:\n        neg_mask = df[col] < 0\n        for idx in df[neg_mask].index:\n            exceptions.append({\n                \"SourceTable\": table_name,\n                \"RecordIdentifier\": str(df.at[idx, pk_col]),\n                \"RuleViolated\": \"NegativeValue\",\n                \"Severity\": \"Medium\",\n                \"Disposition\": \"Quarantine\",\n                \"Description\": f\"Column {col} has negative value {df.at[idx, col]}.\",\n            })\n        good_mask &= ~neg_mask\n\n    # 4. Production unit consistency (specific to FactProduction)\n    if table_name == \"FactProduction\":\n        inc_mask = df['GoodUnits'] + df['RejectedUnits'] != df['ProducedUnits']\n        for idx in df[inc_mask].index:\n            exceptions.append({\n                \"SourceTable\": table_name,\n                \"RecordIdentifier\": str(df.at[idx, pk_col]),\n                \"RuleViolated\": \"UnitSumMismatch\",\n                \"Severity\": \"Medium\",\n                \"Disposition\": \"Quarantine\",\n                \"Description\": \"Good + Rejected does not equal Produced.\",\n            })\n        good_mask &= ~inc_mask\n\n    # Return good rows and exception records\n    good_df = df[good_mask].copy()\n    return good_df, exceptions\n\n\ndef run_validation():\n    raw_dir = BASE_DIR / \"data\" / \"raw\" / \"faulty\"\n    curated_dir = BASE_DIR / \"data\" / \"curated\"\n    curated_dir.mkdir(parents=True, exist_ok=True)\n    # Load dimension tables (assumed clean)\n    dim_tables = {}\n    for dim in [\"DimDate\", \"DimShift\", \"DimLine\", \"DimMachine\", \"DimProduct\", \"DimReason\"]:\n        dim_tables[dim] = pd.read_csv(raw_dir / f\"{dim}.csv\")\n\n    all_exceptions = []\n    # Fact tables metadata – pk and foreign‑key mappings\n    fact_meta = {\n        \"FactProduction\": {\n            \"pk\": \"ProductionKey\",\n            \"fks\": {\n                \"DateKey\": (\"DimDate\", \"DateKey\"),\n                \"ShiftKey\": (\"DimShift\", \"ShiftKey\"),\n                \"MachineKey\": (\"DimMachine\", \"MachineKey\"),\n                \"ProductKey\": (\"DimProduct\", \"ProductKey\"),\n            },\n        },\n        \"FactDowntime\": {\n            \"pk\": \"DowntimeKey\",\n            \"fks\": {\n                \"DateKey\": (\"DimDate\", \"DateKey\"),\n                \"ShiftKey\": (\"DimShift\", \"ShiftKey\"),\n                \"MachineKey\": (\"DimMachine\", \"MachineKey\"),\n                \"ReasonKey\": (\"DimReason\", \"ReasonKey\"),\n            },\n        },\n        \"FactQuality\": {\n            \"pk\": \"QualityKey\",\n            \"fks\": {\n                \"DateKey\": (\"DimDate\", \"DateKey\"),\n                \"ShiftKey\": (\"DimShift\", \"ShiftKey\"),\n                \"MachineKey\": (\"DimMachine\", \"MachineKey\"),\n                \"ProductKey\": (\"DimProduct\", \"ProductKey\"),\n                \"DefectReasonKey\": (\"DimReason\", \"ReasonKey\"),\n            },\n        },\n        \"FactEnergy\": {\n            \"pk\": \"EnergyKey\",\n            \"fks\": {\n                \"DateKey\": (\"DimDate\", \"DateKey\"),\n                \"ShiftKey\": (\"DimShift\", \"ShiftKey\"),\n                \"MachineKey\": (\"DimMachine\", \"MachineKey\"),\n            },\n        },\n        \"FactSensor\": {\n            \"pk\": \"SensorKey\",\n            \"fks\": {\n                \"DateKey\": (\"DimDate\", \"DateKey\"),\n                \"MachineKey\": (\"DimMachine\", \"MachineKey\"),\n            },\n        },\n    }\n\n    # Process each fact table\n    for fact, meta in fact_meta.items():\n        df = pd.read_csv(raw_dir / f\"{fact}.csv\")\n        good_df, exc = validate_table(df, fact, meta[\"pk\"], meta[\"fks\"], dim_tables)\n        # Write curated good rows\n        good_df.to_csv(curated_dir / f\"{fact}.csv\", index=False)\n        # Record exceptions with additional fields\n        for e in exc:\n            e[\"ExceptionKey\"] = None  # placeholder – will be auto‑assigned later\n        all_exceptions.extend(exc)\n\n    # Assemble exception register DataFrame\n    exc_df = pd.DataFrame(all_exceptions, columns=EXCEPTION_COLUMNS)\n    # Assign sequential keys\n    exc_df.insert(0, \"ExceptionKey\", range(1, len(exc_df) + 1))\n    exc_df.to_csv(curated_dir / \"FactDQExceptions.csv\", index=False)\n\n    # Generate a short validation report\n    report_path = BASE_DIR / \"docs\" / \"validation_report.md\"\n    total_records = sum(pd.read_csv(raw_dir / f\"{f}.csv\").shape[0] for f in fact_meta)\n    total_good = sum(pd.read_csv(curated_dir / f\"{f}.csv\").shape[0] for f in fact_meta)\n    total_exceptions = len(exc_df)\n    with open(report_path, \"w\", encoding=\"utf-8\") as f:\n        f.write(\"# Validation Report\\n\\n\")\n        f.write(f\"- Total raw fact records: {total_records}\\n\")\n        f.write(f\"- Accepted (curated) records: {total_good}\\n\")\n        f.write(f\"- Detected exceptions: {total_exceptions}\\n\\n\")\n        f.write(\"## Exception Summary by Rule\\n\\n\")\n        summary = exc_df.groupby(\"RuleViolated\").size().reset_index(name=\"Count\")\n        for _, row in summary.iterrows():\n            f.write(f\"- {row['RuleViolated']}: {row['Count']}\\n\")\n    print(f\"Validation complete. Report written to {report_path}\")\n\nif __name__ == \"__main__\":\n    run_validation()\n"}}]}
